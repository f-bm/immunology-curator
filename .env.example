# Clé API pour le modèle d'analyse (Gemini ou OpenAI)
GEMINI_API_KEY=votre_cle_gemini_api_ici
# Ou si vous préférez OpenAI :
# OPENAI_API_KEY=sk-...

# Clé d'intégration Notion (Interne)
NOTION_API_KEY=secret_votre_token_integration_notion

# ID de la page racine dans Notion où l'arborescence sera construite
# (Trouvable dans l'URL de la page Notion, chaîne de 32 caractères hexadécimaux)
NOTION_ROOT_PAGE_ID=votre_page_id_racine

# URL de base où sera hébergé votre flux et vos fichiers MP3 (ex: GitHub Pages)
PODCAST_BASE_URL=https://votre-compte-github.github.io/immunology-curator
